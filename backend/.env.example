# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev (this scaffold): a local Postgres instance.
# Production: point this at a managed Postgres — Supabase (you already use it),
# Neon, Railway, or RDS all work fine since this is just a standard pg connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/worldshiner2

# --- Auth --------------------------------------------------------------------
# Generate a real random string for this — e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# --- Image storage -------------------------------------------------------
# local (default): saves to ./uploads/ on disk. Fine for local dev ONLY —
# free/starter tiers on Render/Railway/Fly have ephemeral disks that wipe on
# every restart, which would silently delete photos. Use 'supabase' for any
# real deployment.
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=supabase — from your Supabase project's
# Settings -> API page, and a Storage bucket you create and mark Public.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=job-images

# --- Gmail integration (optional) --------------------------------------------
# Scaffolding is fully built and safe to leave unset — /api/gmail/* just
# returns "not configured" until these are set. From a Google Cloud OAuth
# client (Web application type) — see docs/DEPLOYMENT.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# Generate with: openssl rand -hex 32
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Where the Gmail OAuth callback redirects back to after connecting
# FRONTEND_URL=http://localhost:8080

# --- Google sign-in (optional, separate from the Gmail integration above) ---
# Lets users sign up / log in with a Google account (still gated by an
# invite code — see services/invites.service.js). Safe to leave unset — the
# frontend just hides the "Continue with Google" button until this is set.
# From a Google Cloud OAuth client (Web application type) with the app's
# origin(s) added under "Authorized JavaScript origins" — no client secret
# or redirect URI needed, this uses Google Identity Services' ID-token flow.
# GOOGLE_SIGNIN_CLIENT_ID=
